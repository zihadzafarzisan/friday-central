{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY", "APP_URL"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "lint": {},
    "dev": { "cache": false, "persistent": true }
  }
}
